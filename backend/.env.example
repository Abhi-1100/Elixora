# Copy this file to .env and fill in values locally.
# Never commit backend/.env or share its contents.

# PostgreSQL connection string; leave empty to use SQLite.
DATABASE_URL=

# Use different, unique secrets of at least 32 characters.
JWT_SECRET_KEY=
SECRET_KEY=

# Google Identity Services OAuth 2.0 Web Client ID
GOOGLE_CLIENT_ID=

# Google Cloud Translation - Basic API key (backend only)
GOOGLE_TRANSLATE_API_KEY=

# Environment
FLASK_ENV=development
HOST=127.0.0.1
FLASK_DEBUG=false

# Legacy SMTP variables retained for other integrations.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# SOS SMS delivery (Twilio)
TWILIO_ACCOUNT_SID=your-twilio-account-sid
TWILIO_AUTH_TOKEN=your-twilio-auth-token
TWILIO_PHONE_NUMBER=your-twilio-sms-capable-number-in-e164-format

# SOS email delivery (Twilio SendGrid Email API).
# This API key is separate from the Twilio SMS Account SID and Auth Token.
# Create a key with Mail Send permission and authenticate your sender/domain.
SENDGRID_API_KEY=your-sendgrid-mail-send-api-key
SENDGRID_FROM_EMAIL=your-verified-sender@example.com
